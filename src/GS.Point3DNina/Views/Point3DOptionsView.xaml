<UserControl x:Class="GS.Point3DNina.Views.Point3DOptionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="320">
    <!-- The 3D model's options, on NINA's plugin settings page. The DataContext is Point3DOptions. -->
    <UserControl.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Margin" Value="0,2" />
        </Style>
        <!-- Rows that only make sense for the assembled model... -->
        <Style x:Key="AssembledOnly" TargetType="Grid" BasedOn="{StaticResource Row}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding UseAssembly}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- ...and rows that only make sense for the usual (.obj) models. -->
        <Style x:Key="PlainOnly" TargetType="Grid" BasedOn="{StaticResource Row}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding UseAssembly}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <StackPanel Margin="0,4" Grid.IsSharedSizeScope="True">

        <!-- NINA's switch style drops a CheckBox's content, so each text sits beside its switch. -->
        <StackPanel Orientation="Horizontal" Margin="0,2"
                    ToolTip="Show the mount built from separate parts (mount, support and OTA that you pick below) instead of a single ready-made model. Only a German polar mount is available when this is on.">
            <CheckBox IsChecked="{Binding UseAssembly}" />
            <TextBlock Text="Assembled model" Style="{StaticResource Label}" Margin="6,0,0,0" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,2"
                    ToolTip="Show a grid on the ground beneath the model.">
            <CheckBox IsChecked="{Binding ShowGrid}" />
            <TextBlock Text="Ground grid" Style="{StaticResource Label}" Margin="6,0,0,0" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,2"
                    ToolTip="Show the compass directions North, East, South and West around the model.">
            <CheckBox IsChecked="{Binding ShowCardinals}" />
            <TextBlock Text="N E S W" Style="{StaticResource Label}" Margin="6,0,0,0" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,2"
                    ToolTip="Show the mount's current position as chips in the view. Choose which values appear with the boxes below.">
            <CheckBox IsChecked="{Binding ShowCoordinates}" />
            <TextBlock Text="Coordinates" Style="{StaticResource Label}" Margin="6,0,0,0" />
        </StackPanel>
        <!-- Which coordinates show, and RA's units. Double-clicking the RA chip in the view switches its units too. -->
        <WrapPanel Margin="26,0,0,2" IsEnabled="{Binding ShowCoordinates}">
            <StackPanel Orientation="Horizontal" Margin="0,2,12,2" ToolTip="Show Right Ascension."><CheckBox IsChecked="{Binding ShowRa}" /><TextBlock Text="RA" Style="{StaticResource Label}" Margin="6,0,0,0" /></StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,2,12,2" ToolTip="Show Declination."><CheckBox IsChecked="{Binding ShowDec}" /><TextBlock Text="Dec" Style="{StaticResource Label}" Margin="6,0,0,0" /></StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,2,12,2" ToolTip="Show Azimuth."><CheckBox IsChecked="{Binding ShowAz}" /><TextBlock Text="Az" Style="{StaticResource Label}" Margin="6,0,0,0" /></StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,2,12,2" ToolTip="Show Altitude."><CheckBox IsChecked="{Binding ShowAlt}" /><TextBlock Text="Alt" Style="{StaticResource Label}" Margin="6,0,0,0" /></StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,2,12,2" ToolTip="Show Local Hour Angle."><CheckBox IsChecked="{Binding ShowLha}" /><TextBlock Text="LHA" Style="{StaticResource Label}" Margin="6,0,0,0" /></StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,2,12,2" ToolTip="Show Local Sidereal Time."><CheckBox IsChecked="{Binding ShowLst}" /><TextBlock Text="LST" Style="{StaticResource Label}" Margin="6,0,0,0" /></StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,2,12,2" ToolTip="Show Right Ascension in degrees instead of hours, minutes and seconds. Double-clicking the RA chip in the view switches it too."><CheckBox IsChecked="{Binding RaInDegrees}" /><TextBlock Text="RA in degrees" Style="{StaticResource Label}" Margin="6,0,0,0" /></StackPanel>
        </WrapPanel>
        <StackPanel Orientation="Horizontal" Margin="0,2,0,6"
                    ToolTip="A compass in the corner of the view showing which way the camera faces. Click it to turn the view to face the pole: north, or south at a southern latitude.">
            <CheckBox IsChecked="{Binding ShowHeading}" />
            <TextBlock Text="Compass heading" Style="{StaticResource Label}" Margin="6,0,0,0" />
        </StackPanel>

        <!-- Assembled model: the mount, its support and OTA. -->
        <Grid Style="{StaticResource AssembledOnly}"
              ToolTip="The mount for the assembled model.">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="L" /><ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Mount" Style="{StaticResource Label}" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding Mounts}" SelectedValuePath="Value" DisplayMemberPath="Name"
                      SelectedValue="{Binding Mount}" />
        </Grid>
        <Grid Style="{StaticResource AssembledOnly}"
              ToolTip="The pier or tripod the mount sits on, for the assembled model.">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="L" /><ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Support" Style="{StaticResource Label}" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding Supports}" SelectedValuePath="Value" DisplayMemberPath="Name" SelectedValue="{Binding Support}" />
        </Grid>
        <Grid Style="{StaticResource AssembledOnly}"
              ToolTip="The telescope tube (optical tube assembly) fitted to the assembled mount.">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="L" /><ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="OTA" Style="{StaticResource Label}" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding Otas}" SelectedValuePath="Value" DisplayMemberPath="Name" SelectedValue="{Binding Ota}" />
        </Grid>
        <Grid Style="{StaticResource AssembledOnly}"
              ToolTip="Scale the telescope tube as a percentage of its standard size.">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="L" /><ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="OTA size %" Style="{StaticResource Label}" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding OtaSizes}" SelectedItem="{Binding OtaSize}" />
        </Grid>

        <!-- Usual models: the telescope, and the mount type it sits on. -->
        <Grid Style="{StaticResource PlainOnly}"
              ToolTip="Which ready-made telescope and mount model to draw.">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="L" /><ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Telescope" Style="{StaticResource Label}" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding Models}" SelectedItem="{Binding Model}" />
        </Grid>

        <!-- Mount type: only German polar when assembled, so the list holds just that. -->
        <Grid Style="{StaticResource Row}"
              ToolTip="How the mount is aligned: Follow telescope uses what the connected mount reports, or choose German polar, Polar (fork) or Alt-Az yourself. Only German polar is offered for the assembled model.">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="L" /><ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Mount type" Style="{StaticResource Label}" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding ModeChoices}" SelectedItem="{Binding SelectedMode}"
                      DisplayMemberPath="Name" />
        </Grid>
        <Grid Style="{StaticResource PlainOnly}"
              ToolTip="Which side of the fork the telescope tube sits on.">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="L" /><ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Fork side" Style="{StaticResource Label}" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding PolarModes}" SelectedItem="{Binding PolarMode}" />
        </Grid>

        <Grid Style="{StaticResource Row}"
              ToolTip="The picture behind the model in the 3D Model panel: a nebula or galaxy photo, a generated star field, or a plain dark sky.">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="L" /><ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Theme" Style="{StaticResource Label}" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}"
                      ToolTip="Dark, Day, Dusk (amber only) or Night (red only, to keep your eyes dark adapted)." />
        </Grid>
        <Grid Style="{StaticResource Row}"
              ToolTip="The colour of the model. Hover a swatch for its name and click it to use it.">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="L" /><ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Background" Style="{StaticResource Label}" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding Backgrounds}"
                      SelectedValuePath="Key" DisplayMemberPath="Name" SelectedValue="{Binding BackgroundKey}" />
        </Grid>
        <Grid Style="{StaticResource Row}"
              ToolTip="How large the N E S W letters are drawn. Needs N E S W switched on.">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="L" /><ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Colour" Style="{StaticResource Label}" />
            <ItemsControl Grid.Column="1" ItemsSource="{Binding Colors}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Width="22" Height="22" Margin="0,2,4,2" ToolTip="{Binding Name}"
                                Background="{Binding Hex}" CommandParameter="{Binding Hex}"
                                Command="{Binding DataContext.PickColorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
        <Grid Style="{StaticResource Row}"
              ToolTip="Save, reset or forget the camera view used when the 3D Model panel opens.">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="L" /><ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="N E S W size" Style="{StaticResource Label}" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding CardinalSizes}" SelectedItem="{Binding CardinalSize}"
                      IsEnabled="{Binding ShowCardinals}" />
        </Grid>
        <Grid Style="{StaticResource Row}"
              ToolTip="Turn the model about its RA axis by this many degrees, to line it up with your real mount. 0 draws it as GSServer does.">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="L" /><ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Polling time" Style="{StaticResource Label}" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding PollingTimes}" SelectedValuePath="Value" DisplayMemberPath="Name" SelectedValue="{Binding PollingSeconds}"
                      ToolTip="How often the model follows the mount. Match NINA uses NINA's Device polling interval (Options, General). A slower time updates the model less often; it can't be faster than NINA's interval." />
        </Grid>
        <Grid Style="{StaticResource Row}"
              ToolTip="Turn the model about its Dec axis by this many degrees, to line it up with your real mount. 0 draws it as GSServer does.">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="L" /><ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="View" Style="{StaticResource Label}" />
            <WrapPanel Grid.Column="1">
                <Button Content="Save view" Margin="0,2,6,2" Padding="10,3" Command="{Binding SaveViewCommand}"
                        ToolTip="Keep the camera as it is now: the angle, tilt and zoom you have set in the 3D Model panel. It is used each time the panel opens." />
                <Button Content="Reset view" Margin="0,2,6,2" Padding="10,3" Command="{Binding ResetViewCommand}"
                        ToolTip="Move the camera back to the saved view, or to the default view if none is saved." />
                <Button Content="Use default" Margin="0,2,6,2" Padding="10,3" Command="{Binding ForgetViewCommand}"
                        IsEnabled="{Binding HasSavedView}"
                        ToolTip="Forget the saved view and go back to the default one." />
            </WrapPanel>
        </Grid>
        <Grid Style="{StaticResource Row}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="L" /><ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="RA offset °" Style="{StaticResource Label}" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding Offsets}" SelectedItem="{Binding RaOffset}" />
        </Grid>
        <Grid Style="{StaticResource Row}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="L" /><ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Dec offset °" Style="{StaticResource Label}" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding Offsets}" SelectedItem="{Binding DecOffset}" />
        </Grid>
    </StackPanel>
</UserControl>
